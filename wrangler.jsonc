{
  // Cloudflare Workers static assets deployment of the Vite build.
  // Assets-only: no Worker script, so requests are served as free static assets.
  "name": "project-kaizen",
  "compatibility_date": "2026-09-07",
  // Serve at project-kaizen.<account>.workers.dev; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
